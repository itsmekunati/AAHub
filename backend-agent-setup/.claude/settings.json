{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(docker *)",
      "Bash(curl http://127.0.0.1:8080/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git worktree *)",
      "Bash(bash .githooks/pre-commit*)",
      "Edit(./src/**)",
      "Edit(./specs/**)",
      "Edit(./sprints/**)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(yamllint *)",
      "Bash(hadolint *)",
      "Bash(snyk test*)",
      "Bash(snyk iac test*)",
      "Bash(snyk code test*)",
      "Bash(bash .githooks/pre-push*)"
    ],
    "ask": [
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/rules/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./docs/**)",
      "Edit(./Dockerfile)",
      "Edit(./.gitignore)",
      "Edit(./pom.xml)",
      "Edit(./src/main/resources/application*.yml)",
      "Edit(./**/checkstyle*.xml)",
      "Read(./logs/**)",
      "Edit(./.snyk)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.npmrc)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.githooks/**)",
      "Edit(./.git/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./deploy/**)",
      "Edit(./mvnw)",
      "Edit(./mvnw.cmd)",
      "Edit(./.mvn/wrapper/**)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(npm publish *)",
      "Bash(kubectl *)",
      "Bash(oc *)",
      "Bash(helm *)",
      "Bash(argocd *)",
      "Bash(aws *)",
      "Bash(docker login *)",
      "Bash(printenv *)",
      "Bash(printenv)",
      "Bash(./mvnw deploy *)",
      "Bash(mvn deploy *)",
      "Bash(git branch -D *)",
      "Bash(git switch -f *)",
      "Bash(git switch --discard-changes *)",
      "Read(~/.config/configstore/snyk.json)",
      "Bash(snyk auth*)",
      "Bash(snyk monitor*)",
      "Bash(snyk config*)",
      "Bash(snyk ignore*)",
      "Bash(git config hooks.snyk*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-agent-output.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
